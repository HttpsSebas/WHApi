{
  "swagger": "2.0",
  "info": {
    "title": "Whapi messaging API",
    "description": "REST API for a real-time messaging application. Provides authentication, user management, conversations, messages and real-time communication using Socket.IO.",
    "version": "1.0.0",
    "contact": {
      "name": "Sebastian Infante",
      "url": "https://github.com/HttpsSebas"
    }
  },
  "host": "localhost:3000",
  "schemes": ["http"],
  "paths": {
    "/auth/register": {
      "post": {
        "description": "Register a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserRegister"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Login a user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UserLogin"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Logout current user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Get a new access token using a refresh token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": true,
            "example": "your_refresh_token_here"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "your_new_access_token_here"
                },
                "newRefreshToken": {
                  "type": "string",
                  "example": "your_new_refresh_token_here"
                },
                "user": {
                  "$ref": "#/definitions/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "description": "Get user information by user ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "description": "User ID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User Info",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/contacts/": {
      "get": {
        "description": "Get user's contacts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Contacts"
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "description": "Get contact information by contact ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          }
        }
      }
    },
    "/chats/": {
      "get": {
        "description": "Get user's chats",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Chats"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/chats/{id}": {
      "get": {
        "description": "Get chat information by chat ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Chat"
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "description": "Delete a chat by chat ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/messages/{chatId}": {
      "get": {
        "description": "Get messages for a specific chat by chat ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "chatId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Messages"
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },

  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme. Example: 'Bearer {token}'"
    }
  },

  "definitions": {
    "UserRegister": {
      "type": "object",
      "required": ["phone", "password", "name"],
      "properties": {
        "phone": {
          "type": "string",
          "example": "1234567890"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "name": {
          "type": "string",
          "example": "john"
        },
        "description": {
          "type": "string",
          "example": "This is a sample user description."
        }
      }
    },
    "UserLogin": {
      "type": "object",
      "required": ["phone", "password"],
      "properties": {
        "phone": {
          "type": "string",
          "example": "1234567890"
        },
        "password": {
          "type": "string",
          "example": "password123"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "1"
        },
        "name": {
          "type": "string",
          "example": "john"
        },
        "phone": {
          "type": "string",
          "example": "1234567890"
        },
        "description": {
          "type": "string",
          "example": "This is a sample user description."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-02T00:00:00Z"
        },
        "isOnline": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Contact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "3"
        },
        "contactId": {
          "type": "string",
          "example": "1"
        },
        "userId": {
          "type": "string",
          "example": "2"
        },
        "alias": {
          "type": "string",
          "example": "My Friend"
        },
        "phone": {
          "type": "string",
          "example": "0987654321"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        },
        "contactUser": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "example": "1"
            },
            "name": {
              "type": "string",
              "example": "john"
            },
            "phone": {
              "type": "string",
              "example": "1234567890"
            }
          }
        }
      }
    },
    "Contacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Contact"
      }
    },
    "Chat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "1"
        },
        "type": {
          "type": "string",
          "example": "GROUP"
        },
        "name": {
          "type": "string",
          "example": "My Group"
        },
        "description": {
          "type": "string",
          "example": "This is a sample group chat."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/User"
          }
        }
      }
    },
    "Chats": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Chat"
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "1"
        },
        "chatId": {
          "type": "string",
          "example": "1"
        },
        "senderId": {
          "type": "string",
          "example": "2"
        },
        "content": {
          "type": "string",
          "example": "Hello, this is a sample message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        }
      }
    },
    "Messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Message"
      }
    }
  }
}
